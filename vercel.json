{
  "buildCommand": "npm run build:vercel",
  "functions": {
    "api/get-treasure-sheets.ts": {
      "maxDuration": 30
    },
    "api/get-asesores.ts": {
      "maxDuration": 30
    },
    "api/get-drive-images.js": {
      "maxDuration": 30
    },
    "api/serve-drive-image.js": {
      "maxDuration": 30
    },
    "api/get-batch-thumbnails.ts": {
      "maxDuration": 30
    },
    "api/get-newest-products.js": {
      "maxDuration": 30
    },
    "api/provider-quotations.js": {
      "maxDuration": 30
    },
    "api/media-upload.js": {
      "maxDuration": 60
    },
    "api/fast-upload.js": {
      "maxDuration": 60
    },
    "api/feedback.js": {
      "maxDuration": 30
    },
    "api/product-requests.js": {
      "maxDuration": 30
    },
    "api/product-views.ts": {
      "maxDuration": 30
    },
    "api/drive-diagnostics.js": {
      "maxDuration": 30
    },
    "api/drive-cleanup.js": {
      "maxDuration": 60
    },
    "api/health.js": {
      "maxDuration": 10
    },
    "api/cloudinary-upload.js": {
      "maxDuration": 60
    },
    "api/cotizacion-save.ts": {
      "maxDuration": 30
    },
    "api/cotizacion-reports.js": {
      "maxDuration": 30
    },
    "api/quotation-requests.js": {
      "maxDuration": 30
    },
    "api/invitations.ts": {
      "maxDuration": 30
    },
    "api/validate.ts": {
      "maxDuration": 30
    },
    "api/send-email.js": {
      "maxDuration": 30
    },
    "api/user-prefs.js": {
      "maxDuration": 15
    },
    "api/create-product-folders.js": {
      "maxDuration": 60
    },
    "api/og-product.js": {
      "maxDuration": 15
    },
    "api/fotosintesis-ai.ts": {
      "maxDuration": 60
    },
    "api/ghl-create-order.ts": {
      "maxDuration": 30
    },
    "api/ghl-search-products.ts": {
      "maxDuration": 15
    },
    "api/ghl-sync-contact.ts": {
      "maxDuration": 15
    },
    "api/vitrina-select.ts": {
      "maxDuration": 15
    },
    "api/mp-webhook.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/get-batch-thumbnails",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=1800"
        },
        {
          "key": "Vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        },
        {
          "key": "Vary",
          "value": "*"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        },
        {
          "key": "Vary",
          "value": "*"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/((?!api|assets|images).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<handle>[^.]+)\\.tierramadre\\.app"
        }
      ],
      "destination": "/api/ambassador-subdomain?handle=:handle&path=:path*"
    },
    {
      "source": "/cotizacion-soul",
      "destination": "/cotizacion-soul.html"
    },
    {
      "source": "/cotizacion-soul-plan",
      "destination": "/cotizacion-soul-plan.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/product/:itemNumber",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|Slackbot|LinkedInBot|Pinterest|Discordbot).*"
        }
      ],
      "destination": "/api/og-product?itemNumber=:itemNumber"
    },
    {
      "source": "/((?!api|assets|images|@|src|node_modules|\\.)[^.]*)",
      "destination": "/index.html"
    }
  ]
}

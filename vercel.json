{
  "functions": {
    "api/upload-to-drive.js": {
      "maxDuration": 60
    },
    "api/get-treasure-sheets.js": {
      "maxDuration": 30
    },
    "api/get-asesores.js": {
      "maxDuration": 30
    },
    "api/add-treasure-item.js": {
      "maxDuration": 30
    },
    "api/sync-pricing-sheet.js": {
      "maxDuration": 60
    },
    "api/verify-image.js": {
      "maxDuration": 30
    },
    "api/sync-treasure-images.js": {
      "maxDuration": 60
    },
    "api/fetch-drive-to-cloudinary.js": {
      "maxDuration": 60
    },
    "api/get-drive-images.js": {
      "maxDuration": 30
    },
    "api/serve-drive-image.js": {
      "maxDuration": 30
    },
    "api/organize-drive-folders.js": {
      "maxDuration": 60
    },
    "api/submit-feedback.js": {
      "maxDuration": 30
    },
    "api/get-feedback.js": {
      "maxDuration": 30
    },
    "api/update-feedback.js": {
      "maxDuration": 30
    },
    "api/setup-feedback-sheet.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        },
        {
          "key": "Vary",
          "value": "*"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        },
        {
          "key": "Vary",
          "value": "*"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/((?!api|assets|images).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api|assets|images|@|src|node_modules|\\.).*)",
      "destination": "/index.html"
    }
  ]
}

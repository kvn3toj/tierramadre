{
  "functions": {
    "api/upload-to-drive.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/get-inventory-sheets.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/get-asesores.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/add-inventory-item.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/sync-pricing-sheet.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/verify-image.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/sync-cloudinary-to-drive.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/export-cloudinary-images.js": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

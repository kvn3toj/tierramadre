{
  "functions": {
    "api/upload-to-drive.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/get-inventory-sheets.js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

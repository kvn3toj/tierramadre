{
  "name": "tierra-madre-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Internal Advertising Agency Tool for Colombian Emeralds",
  "author": "Tierra Madre <info@tierramadre.co>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev",
    "build": "node scripts/update-version.mjs && node scripts/generate-thumbnails-seed.mjs && tsc -b && vite build",
    "build:vercel": "node scripts/update-version.mjs && node scripts/generate-thumbnails-seed.mjs && node scripts/build-app.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "migrate:convex": "tsx scripts/migrate-sheets-to-convex.ts",
    "migrate:convex:dry": "tsx scripts/migrate-sheets-to-convex.ts --dry-run --table all",
    "smoke:fotosintesis": "node scripts/smoke-fotosintesis-endpoints.mjs",
    "scan:fotosintesis": "node scripts/scan-fotosintesis-publish.mjs",
    "scan:fotosintesis:prod": "node scripts/scan-fotosintesis-publish.mjs --prod",
    "analyze:conversations": "tsx scripts/analyze-conversations.ts",
    "analyze:conversations:dry": "tsx scripts/analyze-conversations.ts --limit 10",
    "apply:backfill": "tsx scripts/apply-backfill.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@googleapis/drive": "^8.0.0",
    "@googleapis/sheets": "^9.0.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "@react-oauth/google": "^0.12.2",
    "@zumer/snapdom": "^2.12.9",
    "cloudinary": "^2.8.0",
    "convex": "^1.35.1",
    "date-fns": "^4.1.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.26",
    "google-auth-library": "^9.0.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.555.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-easy-crop": "^5.5.6",
    "react-error-boundary": "^6.0.0",
    "react-intersection-observer": "^10.0.0",
    "react-pdf": "^10.2.0",
    "react-router-dom": "^7.9.6",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^2.2.3",
    "sharp": "^0.34.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.6.24",
    "@vitejs/plugin-react": "^4.3.3",
    "dotenv": "^17.4.2",
    "googleapis": "^170.0.0",
    "jsdom": "25.0.1",
    "open": "^11.0.0",
    "puppeteer": "^24.32.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.3"
  }
}
